# ==============================================================================
# AVERO MediaFlow API Configuration
# ==============================================================================

# Environment mode: development / staging / production
ENVIRONMENT=development

# Core API Settings
PROJECT_NAME="AVERO API"
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & Admin Authentication Token (Generate a 64+ char random string in production)
# Example: openssl rand -hex 32
API_SECRET_TOKEN=CHANGE_ME_IN_PRODUCTION

# Allowed CORS Origins (Comma-separated list or JSON array)
# In production, set to your actual domain, e.g. ["https://avero.app"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Trusted Reverse Proxy IPs (e.g. Nginx, Cloudflare, Traefik)
TRUSTED_PROXIES=["127.0.0.1","::1"]

# Optional YouTube Data API v3 Key (Only required for YouTube search functionality)
YOUTUBE_API_KEY=

# Redis Cache & Queue Connection (Optional - defaults to local memory if unavailable)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting & Safety Limits
RATE_LIMIT_PER_MINUTE=30
MAX_URLS_PER_BATCH=20
MAX_CONCURRENT_DOWNLOADS=3
MAX_FILE_SIZE_BYTES=2147483648
DOWNLOAD_TIMEOUT_SECONDS=600
TEMP_FILE_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=600

# Platform Toggles (true/false)
ENABLE_PLATFORM_YOUTUBE=true
ENABLE_PLATFORM_INSTAGRAM=true
ENABLE_PLATFORM_TIKTOK=true
ENABLE_PLATFORM_FACEBOOK=true
ENABLE_PLATFORM_X_TWITTER=true
ENABLE_PLATFORM_PINTEREST=true
ENABLE_PLATFORM_REDDIT=true
ENABLE_PLATFORM_THREADS=true
