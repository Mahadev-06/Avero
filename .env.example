# ============================================
# MediaFlow — Environment Configuration
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADS_ENABLED=false

# ---- Backend ----
REDIS_URL=redis://localhost:6379/0
API_SECRET_TOKEN=change-this-to-a-secure-random-string-min-32-characters-long
CORS_ORIGINS=["http://localhost:3000"]
MEDIA_STORAGE_PATH=/tmp/media_storage

# ---- Platform API Keys (server-side only, NEVER expose to frontend) ----
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ---- Limits ----
MAX_URLS_PER_BATCH=20
MAX_CONCURRENT_JOBS=2
MAX_FILE_SIZE_MB=500
JOB_TIMEOUT_SECONDS=600
TEMP_FILE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=30

# ---- Platform Toggles ----
ENABLE_PLATFORM_YOUTUBE=true
ENABLE_PLATFORM_INSTAGRAM=true
ENABLE_PLATFORM_TIKTOK=true
ENABLE_PLATFORM_FACEBOOK=true
ENABLE_PLATFORM_X=true
